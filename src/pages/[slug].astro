---
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import { allPosts, fmtDate } from '../lib';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, next: posts[i + 1] ?? posts[0] },
  }));
}
const { post, next } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const archive = `https://web.archive.org/web/2024/https://andrewhy.de/${post.id}/`;
---
<Base title={d.title} description={d.description} image={d.cover}>
  <article class="post wrap">
    <header>
      <p class="meta"><a href="/writing/">Writing</a> <span aria-hidden="true">/</span> {d.category}{d.date && <> <span aria-hidden="true">/</span> <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time></>}</p>
      <h1>{d.title}</h1>
      {d.description && <p class="dek">{d.description}</p>}
    </header>
    {d.cover && <img class="cover" src={d.cover} alt="" />}
    <div class="prose">
      {d.stub ? (
        <div class="stub">
          <p>This post is on its way over from the old blog. Until it lands, the original lives in the archive.</p>
          <a class="btn" href={archive}>Read the archived version</a>
        </div>
      ) : <Content />}
    </div>
    <footer class="next">
      <span>Next</span>
      <a href={`/${next.id}/`}>{next.data.title}</a>
    </footer>
  </article>
</Base>

<style>
  .post { max-width: 46rem; padding-block: clamp(2rem, 6vw, 5rem); }
  .meta { color: var(--pine-soft); font-size: var(--step--1); margin: 0 0 1.25rem; }
  .meta span { margin-inline: .35rem; color: var(--granite-deep); }
  h1 { font-size: clamp(2.3rem, 6vw, 4.2rem); line-height: 1; letter-spacing: -0.04em; margin: 0; font-variation-settings: 'wdth' 85; text-wrap: balance; }
  .dek { font-family: var(--serif); font-style: italic; font-size: var(--step-2); line-height: 1.3; color: var(--pine-soft); margin: 1.25rem 0 0; }
  .cover { border-radius: 14px; margin-top: 2.5rem; }
  .prose { margin-top: 2.5rem; font-family: var(--serif); font-size: 1.24rem; line-height: 1.65; font-variation-settings: 'opsz' 16; }
  .prose :global(p), .prose :global(ul), .prose :global(ol), .prose :global(blockquote) { margin: 0 0 1.25em; max-width: 65ch; }
  .prose :global(h2), .prose :global(h3) { font-family: var(--sans); letter-spacing: -0.02em; line-height: 1.15; margin: 2em 0 .6em; }
  .prose :global(h2) { font-size: var(--step-3); }
  .prose :global(h3) { font-size: var(--step-2); }
  .prose :global(a) { color: var(--sky); }
  .prose :global(img) { border-radius: 10px; margin: 2rem 0; }
  .prose :global(blockquote) { border-left: 3px solid var(--rust); padding-left: 1.25rem; font-style: italic; color: var(--pine-soft); }
  .prose :global(li) { margin-bottom: .4em; }
  .stub { background: var(--granite); border-radius: 14px; padding: 1.75rem; font-family: var(--sans); font-size: var(--step-0); }
  .stub p { margin: 0 0 1.25rem; }
  .next { margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--granite-deep); display: grid; gap: .3rem; }
  .next span { color: var(--pine-soft); font-size: var(--step--1); }
  .next a { font-family: var(--serif); font-size: var(--step-2); text-decoration: none; line-height: 1.2; }
</style>
