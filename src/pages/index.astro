---
import Base from '../layouts/Base.astro';
import Built from '../components/Built.astro';
import PostList from '../components/PostList.astro';
import Goals from '../components/Goals.astro';
import Places from '../components/Places.astro';
import { data, allPosts } from '../lib';

const site = data('site');
const posts = await allPosts();
const featured = posts.filter((p) => p.data.description).slice(0, 8);
const word = (s: string, start = 0) => [...s].map((ch, i) => ({ ch, i: i + start }));
---
<Base>
  <section class="hero wrap" data-hero>
    <h1 class="mark" aria-label="Andrew Hyde">
      <span class="line" aria-hidden="true">{word('andrew').map((l) => <span class="l" style={`--i:${l.i}`}>{l.ch}</span>)}</span>
      <span class="line" aria-hidden="true">{word('hy', 6).map((l) => <span class="l" style={`--i:${l.i}`}>{l.ch}</span>)}<span class="tld">{word('.de', 8).map((l) => <span class="l" style={`--i:${l.i}`}>{l.ch}</span>)}</span></span>
    </h1>

    <figure class="photo" data-tilt>
      <img src="/images/andrew-yosemite.jpg" srcset="/images/andrew-yosemite-600.jpg 600w, /images/andrew-yosemite.jpg 1200w" sizes="(max-width: 760px) 80vw, 30vw" width="1200" height="1601" alt="Andrew grinning in a rust-colored jacket on a granite dome in Yosemite, Half Dome and the snowy Sierra behind him." fetchpriority="high" />
      <figcaption>Yosemite, with Half Dome over my shoulder</figcaption>
    </figure>

    <div class="intro">
      <p>{site.intro}</p>
      <p class="outro">{site.outro}</p>
      <div class="ctas">
        <a class="btn solid" href={`mailto:${site.email}`}>Email me</a>
        <a class="btn" href="/writing/">Read the writing</a>
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="built-h">
    <div class="section-head">
      <h2 id="built-h">Things I started</h2>
      <p>Events, companies and a book. Most of them outgrew me, which was the point.</p>
    </div>
    <Built items={site.built} />
  </section>

  <section class="section wrap" aria-labelledby="writing-h">
    <div class="section-head">
      <h2 id="writing-h">Writing</h2>
      <p>Notes on startups, community, minimalism and a lot of travel, rescued from the old blog.</p>
    </div>
    <PostList posts={featured} />
    <p class="more"><a class="btn" href="/writing/">All {posts.length} posts</a></p>
  </section>

  <section class="section band" aria-labelledby="goals-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="goals-h">The list</h2>
        <p>A public bucket list I've kept for years. Some done, some in progress, some honestly not planned.</p>
      </div>
      <Goals />
    </div>
  </section>

  <section class="section wrap" aria-labelledby="places-h">
    <div class="section-head">
      <h2 id="places-h">Places I've been</h2>
      <p>Every country and territory so far. Pick a region to light it up.</p>
    </div>
    <Places />
  </section>
</Base>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const card = document.querySelector<HTMLElement>('[data-tilt]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (hero && card && !still && matchMedia('(pointer: fine)').matches) {
    let raf = 0;
    hero.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      const x = (e.clientX - (r.left + r.width / 2)) / innerWidth;
      const y = (e.clientY - (r.top + r.height / 2)) / innerHeight;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        card.style.setProperty('--ry', `${x * 14}deg`);
        card.style.setProperty('--rx', `${-y * 10}deg`);
      });
    });
    hero.addEventListener('pointerleave', () => { card.style.setProperty('--ry', '0deg'); card.style.setProperty('--rx', '0deg'); });
  }
</script>

<style>
  .hero {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter);
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(3rem, 6vw, 5rem); align-items: end;
  }
  .mark {
    grid-column: 1 / 13; grid-row: 1; margin: 0; position: relative; z-index: 2;
    font-size: clamp(5.2rem, 19.5vw, 17.5rem); line-height: .8; letter-spacing: -0.05em; font-weight: 800;
    pointer-events: none;
  }
  .line { display: block; }
  .line + .line { padding-left: .06em; }
  .l {
    display: inline-block; pointer-events: auto;
    font-variation-settings: 'wdth' 75;
    animation: up 1s var(--ease) both; animation-delay: calc(var(--i) * 55ms + 150ms);
    transition: font-variation-settings .5s var(--ease), color .3s;
  }
  .l:hover { font-variation-settings: 'wdth' 100; }
  .tld .l { color: var(--sky); }
  @keyframes up { from { transform: translateY(.45em) rotate(4deg); opacity: 0; } }

  .photo {
    grid-column: 8 / 13; grid-row: 1 / 3; align-self: start; margin: clamp(3rem, 8vw, 7rem) 0 0;
    perspective: 900px; z-index: 1;
    animation: drop 1.2s var(--ease) both .55s;
  }
  .photo img {
    border-radius: 18px; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 40%;
    transform: rotate(3deg) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform .5s var(--ease);
    box-shadow: 0 30px 60px -30px rgb(23 50 42 / .55);
  }
  .photo figcaption { font-size: var(--step--1); color: var(--pine-soft); margin-top: 1.1rem; text-align: right; }
  @keyframes drop { from { opacity: 0; transform: translateY(-40px) rotate(-6deg); } }

  .intro { grid-column: 1 / 7; grid-row: 2; padding-top: clamp(2rem, 4vw, 3rem); max-width: 34rem; animation: fade .8s var(--ease) both 1s; }
  .intro p { margin: 0 0 1rem; font-size: var(--step-1); line-height: 1.45; }
  .intro .outro { color: var(--pine-soft); font-size: var(--step-0); }
  .ctas { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 1.75rem; }
  @keyframes fade { from { opacity: 0; transform: translateY(10px); } }

  .band { background: var(--granite); }
  .more { margin-top: 2rem; }

  @media (max-width: 760px) {
    .mark { grid-column: 1 / 13; font-size: 30vw; }
    .photo { grid-column: 3 / 13; grid-row: 2; margin-top: 1.75rem; }
    .intro { grid-column: 1 / 13; grid-row: 3; }
  }
</style>
