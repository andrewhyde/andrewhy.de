---
import Base from '../layouts/Base.astro';
import Goals from '../components/Goals.astro';
import { data } from '../lib';
const goals = data('goals');
---
<Base title="Goals" description="Andrew Hyde's public bucket list.">
  <section class="section wrap">
    <div class="section-head">
      <h1 class="h">The list</h1>
      <p>{goals.intro}</p>
    </div>
    <Goals />
  </section>
</Base>
<style>
  .section { padding-top: clamp(2rem, 5vw, 4rem); }
  .h { font-size: clamp(3rem, 9vw, 7rem); line-height: .9; letter-spacing: -0.05em; margin: 0; font-variation-settings: 'wdth' 80; }
</style>
