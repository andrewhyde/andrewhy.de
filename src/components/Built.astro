---
const { items } = Astro.props as { items: { name: string; blurb: string; url?: string }[] };
---
<ul class="built" role="list">
  {items.map((it) => (
    <li>
      <details>
        <summary><span class="name">{it.name}</span><span class="plus" aria-hidden="true"></span></summary>
        <p>{it.blurb}{it.url && <> <a href={it.url}>{it.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></>}</p>
      </details>
    </li>
  ))}
</ul>

<style>
  .built { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--granite-deep); }
  li { border-bottom: 1px solid var(--granite-deep); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding-block: clamp(1rem, 2.2vw, 1.5rem);
  }
  summary::-webkit-details-marker { display: none; }
  .name {
    font-size: clamp(1.6rem, 4.4vw, 3.4rem); font-weight: 650; letter-spacing: -0.035em; line-height: 1.05;
    font-variation-settings: 'wdth' 82; transition: font-variation-settings .45s var(--ease), color .2s;
  }
  summary:hover .name, details[open] .name { font-variation-settings: 'wdth' 100; }
  summary:hover .name { color: var(--sky); }
  .plus { width: 1.6rem; height: 1.6rem; position: relative; flex: none; transition: transform .35s var(--ease); }
  .plus::before, .plus::after { content: ''; position: absolute; inset: 50% 0 auto; height: 2px; background: currentColor; translate: 0 -50%; }
  .plus::after { rotate: 90deg; transition: rotate .35s var(--ease); }
  details[open] .plus::after { rotate: 0deg; }
  details[open] .plus { transform: rotate(180deg); color: var(--rust); }
  p { margin: -.25rem 0 1.5rem; max-width: 52ch; color: var(--pine-soft); font-size: var(--step-1); line-height: 1.45; animation: drop .4s var(--ease); }
  p a { color: var(--sky); }
  @keyframes drop { from { opacity: 0; transform: translateY(-6px); } }
</style>
